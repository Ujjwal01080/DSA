{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Solution with input.txt",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "javac Solution.java && java Solution < input.txt > output.txt"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}